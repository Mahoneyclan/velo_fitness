# Strava API credentials
# Create at: https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Garmin Connect credentials (your regular login)
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=yourpassword

# Optional — boxing_extract.py overrides.
# Confirm the real typeKey(s) with `python boxing_extract.py --discover` first.
# BOXING_ACTIVITY_TYPES=boxing,kickboxing,cardio_kickboxing,boxing_fitness
# ICLOUD_OUTPUT_DIR=/Users/you/Library/Mobile Documents/iCloud~mahoneyclan~VeloFitness/Documents
